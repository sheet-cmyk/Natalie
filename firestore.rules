rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'hussein1sheet@gmail.com' ||
        request.auth.uid in [
          'zO8KCjQ9iYXTBg7xe7Ru3ZPL7yF3',
          '7LYJJ9FR6eU5YYVxWOdn7Ok2p4t1',
          'QTzvO5yuV7aZ24PC0qHUEyIxrVv2',
          '7KyzgxPXNDXftSLxSLzSNNLJwAS2'
        ] ||
        (exists(/databases/$(database)/documents/admin_sessions/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_sessions/$(request.auth.uid)).data.secret == 'om_admin_session_v1_granted')
      );
    }

    function hasActiveSubscription(uid) {
      let sub = get(/databases/$(database)/documents/users/$(uid)).data.get('subscription', null);
      return sub != null &&
             sub.get('status', 'inactive') == 'active' &&
             (
               !sub.keys().hasAny(['expiresAt']) ||
               sub.expiresAt > request.time
             );
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // User can update their own doc, but NOT the subscription field
      allow write: if isAdmin();
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['subscription'])
                    && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']));
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /ads/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // User can edit their ad and request publishing (pendingPublish) but cannot set published=true
      allow update: if isAdmin() ||
                    (request.auth != null && request.auth.uid == userId &&
                     !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['published'])));
      allow delete: if isAdmin() ||
                    (request.auth != null && request.auth.uid == userId);
    }

    match /banner_ads/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /post_likes/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /friend_requests/{reqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null
                    && (resource.data.from == request.auth.uid
                        || resource.data.to == request.auth.uid);
    }

    match /friends/{uid}/list/{friendId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && (request.auth.uid == uid || request.auth.uid == friendId);
    }

    match /profile_views/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /viewers/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /admin_sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if request.auth != null;
    }

    match /inbox/{uid}/messages/{msgId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid;
    }
  }
}
